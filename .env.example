# CLR runtime selection (auto | coreclr | netfx)
DOTNET_RUNTIME=auto

# Explicit assembly overrides (win over auto-probes)
# DACFX_DLL_HINT=C:\path\to\Microsoft.SqlServer.Dac.dll
# SCRIPTDOM_DLL_HINT=C:\path\to\Microsoft.SqlServer.TransactSql.ScriptDom.dll
# SQLCLIENT_DLL_HINT=C:\path\to\Microsoft.Data.SqlClient.dll

# NuGet fetch source (v3 flat container)
NUGET_SOURCE=https://api.nuget.org/v3-flatcontainer
# NuGet package version pins (empty = latest stable)
# DACFX_VERSION=162.5.57
# SCRIPTDOM_VERSION=162.5.57
# SQLCLIENT_VERSION=5.2.2

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Default output directory for lineage artifacts
OUTPUT_DIR=./out

# Named DB connections. Referenced by CLI as `--connection <name>`.
# Format: DB__<NAME>__SERVER, DB__<NAME>__DATABASE
# DB__PROD__SERVER=myserver.database.windows.net
# DB__PROD__DATABASE=warehouse
# DB__SYNAPSE__SERVER=mypool.sql.azuresynapse.net
# DB__SYNAPSE__DATABASE=analytics
