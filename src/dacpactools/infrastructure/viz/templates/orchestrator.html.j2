<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Orchestrator lineage — {{ run_name }}</title>
  <script src="https://unpkg.com/cytoscape@3.30.2/dist/cytoscape.min.js"></script>
  <script src="https://unpkg.com/dagre@0.8.5/dist/dagre.min.js"></script>
  <script src="https://unpkg.com/cytoscape-dagre@2.5.0/cytoscape-dagre.js"></script>
  <style>
    :root { color-scheme: light dark; }
    html, body { margin: 0; height: 100%; font-family: system-ui, sans-serif; }
    #layout { display: grid; grid-template-columns: 1fr 420px; height: 100vh; }
    #graph { border-right: 1px solid #333; background: #111; }
    #side { padding: 16px 20px; overflow-y: auto; background: #1b1b1b; color: #eee; }
    header { padding: 10px 16px; background: #222; color: #eee; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
    header .name { font-weight: 600; }
    header .warn { color: #f0a020; }
    h2 { font-size: 15px; margin: 12px 0 4px; color: #ddd; }
    table { border-collapse: collapse; width: 100%; font-size: 12px; }
    th, td { text-align: left; padding: 3px 6px; border-bottom: 1px solid #333; vertical-align: top; }
    pre { background: #000; color: #7fc; padding: 6px 8px; border-radius: 4px; white-space: pre-wrap; word-break: break-word; font-size: 11px; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 8px; font-size: 11px; margin-left: 8px; }
    .badge.PIPELINE { background: #4b6cff; }
    .badge.ACTIVITY { background: #2aa198; }
    .badge.DATASET { background: #859900; }
    .badge.UNSUPPORTED { background: #cb4b16; }
    .not-direct { color: #f0a020; }
  </style>
</head>
<body>
  <div id="layout">
    <div>
      <header>
        <div class="name">Run: {{ run_name }}</div>
        <div>Pipelines: {{ pipeline_count }}</div>
        <div>Activities: {{ activity_count }}</div>
        <div>Lineage graphs: {{ graph_count }}</div>
        {% if warnings %}<div class="warn">Warnings: {{ warnings|length }}</div>{% endif %}
      </header>
      <div id="graph" style="height: calc(100vh - 44px);"></div>
    </div>
    <aside id="side">
      <h1 style="font-size: 15px; margin: 0 0 10px;">Details</h1>
      <div id="detail">Click a node to inspect activity SQL, dataset columns, and mappings.</div>
      {% if warnings %}
        <h2>Run warnings</h2>
        <ul>{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul>
      {% endif %}
    </aside>
  </div>

  <script id="graph-data" type="application/json">{{ data_json|safe }}</script>
  <script>
    (function () {
      const data = JSON.parse(document.getElementById('graph-data').textContent);
      const elements = [];
      const nodeIndex = { pipelines: {}, activities: {}, datasets: {} };

      for (const p of data.pipelines) {
        const pipeId = 'pipe:' + p.pipelineId;
        elements.push({ data: {
          id: pipeId, label: p.name + '\n(' + p.kind + ')',
          nodeKind: 'PIPELINE', payload: p
        }});
        nodeIndex.pipelines[pipeId] = p;

        for (const a of p.activities) {
          const actId = 'act:' + p.pipelineId + ':' + a.activityId;
          elements.push({ data: {
            id: actId, parent: pipeId,
            label: a.name + '\n[' + a.activityType + ']',
            nodeKind: 'ACTIVITY', payload: a, pipelineId: p.pipelineId
          }});
          nodeIndex.activities[actId] = a;

          if (a.lineageGraphId && data.lineageGraphs[a.lineageGraphId]) {
            const g = data.lineageGraphs[a.lineageGraphId];
            for (const dn of g.nodes) {
              const dsId = 'ds:' + a.lineageGraphId + ':' + dn.ref;
              if (!nodeIndex.datasets[dsId]) {
                elements.push({ data: {
                  id: dsId,
                  label: dn.ref + '\n(' + dn.objectType + ')',
                  nodeKind: 'DATASET', payload: dn, lineageGraphId: a.lineageGraphId
                }});
                nodeIndex.datasets[dsId] = dn;
              }
              elements.push({ data: {
                id: 'holds:' + actId + '->' + dsId,
                source: actId, target: dsId, edgeKind: 'HOLDS'
              }});
            }
            for (const e of g.edges) {
              const s = 'ds:' + a.lineageGraphId + ':' + e.from;
              const t = 'ds:' + a.lineageGraphId + ':' + e.to;
              elements.push({ data: {
                id: 'ref:' + s + '->' + t + ':' + a.activityId,
                source: s, target: t, edgeKind: e.kind
              }});
            }
          }
        }

        for (const dep of p.dependencies) {
          const s = 'act:' + p.pipelineId + ':' + dep.from;
          const t = 'act:' + p.pipelineId + ':' + dep.to;
          elements.push({ data: {
            id: 'dep:' + s + '->' + t, source: s, target: t, edgeKind: 'DEPENDS_ON'
          }});
        }
      }

      const cy = cytoscape({
        container: document.getElementById('graph'),
        elements,
        style: [
          { selector: 'node', style: {
              'label': 'data(label)',
              'text-wrap': 'wrap', 'text-valign': 'center', 'text-halign': 'center',
              'color': '#fff', 'font-size': 11, 'font-family': 'system-ui',
              'text-outline-width': 1, 'text-outline-color': '#000',
              'background-color': '#586e75',
              'width': 'label', 'height': 'label',
              'padding': '10px', 'shape': 'round-rectangle'
          }},
          { selector: 'node[nodeKind = "PIPELINE"]', style: {
              'background-color': '#1b2b55', 'background-opacity': 0.35,
              'border-width': 1, 'border-color': '#4b6cff',
              'shape': 'round-rectangle',
              'text-valign': 'top', 'text-halign': 'center'
          }},
          { selector: 'node[nodeKind = "ACTIVITY"]', style: {
              'background-color': '#2aa198'
          }},
          { selector: 'node[nodeKind = "DATASET"]', style: {
              'background-color': '#859900'
          }},
          { selector: 'edge', style: {
              'width': 1.5, 'line-color': '#556', 'target-arrow-color': '#889',
              'target-arrow-shape': 'triangle', 'curve-style': 'bezier'
          }},
          { selector: 'edge[edgeKind = "DEPENDS_ON"]', style: {
              'line-color': '#f0a020', 'target-arrow-color': '#f0a020', 'width': 2.5
          }},
          { selector: 'edge[edgeKind = "HOLDS"]', style: {
              'line-color': '#334', 'target-arrow-color': '#334', 'line-style': 'dashed'
          }},
          { selector: 'node:selected', style: { 'border-width': 3, 'border-color': '#f0a020' }},
        ],
        layout: { name: 'dagre', rankDir: 'LR', nodeSep: 40, rankSep: 90 },
        wheelSensitivity: 0.2
      });

      const detail = document.getElementById('detail');

      function renderActivity(a) {
        const warns = a.warnings.length
          ? '<h2 class="warn">Activity warnings</h2><ul>' + a.warnings.map(w => '<li>' + w + '</li>').join('') + '</ul>'
          : '';
        const sql = a.sqlText ? '<h2>SQL</h2><pre>' + a.sqlText + '</pre>' : '<h2>SQL</h2><em>none captured</em>';
        return '<h2>' + a.name + ' <span class="badge ACTIVITY">' + a.activityType + '</span></h2>' +
          '<table><tbody>' +
          '<tr><th>Activity id</th><td>' + a.activityId + '</td></tr>' +
          '<tr><th>Env ref</th><td>' + (a.envRef || '<em>none</em>') + '</td></tr>' +
          '<tr><th>Order</th><td>' + a.order + '</td></tr>' +
          '<tr><th>Depends on</th><td>' + (a.dependsOn.join(', ') || '<em>none</em>') + '</td></tr>' +
          '<tr><th>Lineage graph</th><td>' + (a.lineageGraphId || '<em>none</em>') + '</td></tr>' +
          '</tbody></table>' + sql + warns;
      }

      function renderDataset(dn) {
        const cols = dn.columns.map(c => '<tr><td>' + (c.ordinal ?? '') + '</td><td>' + c.name + '</td><td>' + (c.dataType || '') + '</td></tr>').join('');
        const maps = dn.columnMappings.map(m => {
          const src = m.sources.map(s => s.object + '.' + s.column).join(', ') || '<em>none</em>';
          const cls = m.isDirect ? '' : ' class="not-direct"';
          return '<tr' + cls + '><td>' + m.target.column + '</td><td>' + src + '</td><td>' + (m.isDirect ? 'yes' : 'no') + '</td><td><code>' + (m.expression || '') + '</code></td></tr>';
        }).join('');
        return '<h2>' + dn.ref + ' <span class="badge DATASET">' + dn.objectType + '</span></h2>' +
          '<h2>Columns</h2><table><thead><tr><th>#</th><th>Name</th><th>Type</th></tr></thead><tbody>' + (cols || '<tr><td colspan=3><em>none</em></td></tr>') + '</tbody></table>' +
          '<h2>Column mappings</h2><table><thead><tr><th>Target</th><th>Sources</th><th>Direct</th><th>Expression</th></tr></thead><tbody>' + (maps || '<tr><td colspan=4><em>none</em></td></tr>') + '</tbody></table>';
      }

      function renderPipeline(p) {
        return '<h2>' + p.name + ' <span class="badge PIPELINE">' + p.kind + '</span></h2>' +
          '<table><tbody>' +
          '<tr><th>Pipeline id</th><td>' + p.pipelineId + '</td></tr>' +
          '<tr><th>Source</th><td>' + p.sourcePath + '</td></tr>' +
          '<tr><th>Activities</th><td>' + p.activities.length + '</td></tr>' +
          '<tr><th>Dependencies</th><td>' + p.dependencies.length + '</td></tr>' +
          '</tbody></table>';
      }

      cy.on('tap', 'node', (evt) => {
        const kind = evt.target.data('nodeKind');
        const payload = evt.target.data('payload');
        if (kind === 'ACTIVITY') detail.innerHTML = renderActivity(payload);
        else if (kind === 'DATASET') detail.innerHTML = renderDataset(payload);
        else if (kind === 'PIPELINE') detail.innerHTML = renderPipeline(payload);
      });
    })();
  </script>
</body>
</html>
